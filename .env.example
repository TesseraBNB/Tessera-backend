# ============================================================
# Tessera — Environment Configuration
# Copy to .env:  cp .env.example .env     (Windows: copy .env.example .env)
# The server reads .env from the directory you start it in.
# ============================================================

# --- HTTP server ---
PORT=8080
# Comma-separated CORS allowlist. The deployed frontend
# (https://tessera-bnb.vercel.app) calls the backend on your own machine at
# http://localhost:8080, so it must stay listed. Never use "*" when exposed.
ALLOWED_ORIGINS=http://localhost:3000,https://tessera-bnb.vercel.app

# ============================================================
# AI agent — Tessera owns the tool-calling loop and speaks the
# Anthropic Messages API to any compatible provider.
# Without a key the server still runs: data/Explore endpoints work and
# the agent endpoints answer 503 until a key is set.
# ============================================================

# Quick start: a free xKiro key (https://xkiro.com) with a free model.
ANTHROPIC_BASE_URL=https://api.xkiro.com
ANTHROPIC_API_KEY=
TESSERA_MODEL=qwen/qwen3.8-omni-flash:free

# Using Claude directly instead: leave ANTHROPIC_BASE_URL empty (defaults to
# https://api.anthropic.com), put an Anthropic key above, and set
# TESSERA_MODEL=claude-opus-4-8.

# Optional second Messages-compatible provider, tried if the first fails.
# It has its own model id (defaults to TESSERA_MODEL). QwenCloud example:
#   FALLBACK_BASE_URL=https://token-plan.maas.qwencloudapi.com/apps/anthropic  (sk-sp- Token Plan keys)
#   FALLBACK_BASE_URL=https://maas.qwencloudapi.com/apps/anthropic             (sk- pay-as-you-go keys)
#   FALLBACK_MODEL=qwen3.8-flash
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# Optional relay tried before everything else (Anthropic Messages API shape).
HERMES_BASE_URL=
HERMES_TOKEN=

# ============================================================
# Data sources (optional — enrich cross-referencing)
# ============================================================
# Open Source Observer (free key: https://www.oso.xyz → Settings → API Keys).
# Enables Gitcoin Grants history and OSO project signals.
OSO_API_KEY=
GITHUB_TOKEN=

# ============================================================
# Limits & guards (optional — sensible defaults applied)
# ============================================================
# Per-IP token-bucket rate limit (requests/second) and burst size.
# Comfortable for one person clicking around locally; tighten when public.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
# Max tool-use rounds per agent run.
AGENT_MAX_ITERATIONS=12
# Global cap on agent runs per day (0 = unlimited) — protects against cost blowups.
AGENT_DAILY_BUDGET=0
# In-memory cache TTL for upstream data (e.g. 10m, 30s).
CACHE_TTL=10m

# ============================================================
# Verdict notary (optional) — BNB Attestation Service on BSC testnet
# ============================================================
# A dedicated, funded key that signs verdict attestations. Notarisation is off
# without it. Run `tessera notary-setup` once to register the schema.
NOTARY_PRIVATE_KEY=
# NOTARY_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# NOTARY_BAS_CONTRACT=0x6c2270298b1e6046898a322acB3Cbad6F99f7CBD
# NOTARY_CHAIN_ID=97
# NOTARY_DAILY_BUDGET=50
# Public URL of this API, written into attested report links (Railway sets it).
# PUBLIC_URL=
