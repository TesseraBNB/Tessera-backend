# ============================================================
# Tessera — Environment Configuration
# Copy to .env:  cp .env.example .env
# ============================================================

# --- HTTP server ---
# Port to listen on. Railway injects PORT automatically in production.
PORT=8080
# Comma-separated CORS allowlist (your Vercel frontend + local dev).
# Use "*" only for quick local testing — never in production.
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# AI agent  (Option A: Tessera owns the tool-calling loop)
# ============================================================
# Primary: Hermes relays the Anthropic Messages API (tools/tool_use) to a real
# Claude Code Opus 4.8 agent. If unset or failing, Tessera falls back to the
# Anthropic API directly. Set at least one of HERMES_BASE_URL or ANTHROPIC_API_KEY.
HERMES_BASE_URL=
HERMES_TOKEN=

# Fallback (and the simplest way to run locally): a direct Anthropic API key.
ANTHROPIC_API_KEY=

# Model id used for the agent (default: claude-opus-4-8).
TESSERA_MODEL=claude-opus-4-8

# ============================================================
# Data sources (optional — enrich cross-referencing)
# ============================================================
OSO_API_KEY=
GITHUB_TOKEN=

# ============================================================
# Limits & guards (optional — sensible defaults applied)
# ============================================================
# Per-IP token-bucket rate limit (requests/second) and burst size.
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=5
# Max tool-use rounds per agent run.
AGENT_MAX_ITERATIONS=12
# Global cap on agent runs per day (0 = unlimited) — protects against cost blowups.
AGENT_DAILY_BUDGET=0
# In-memory cache TTL for upstream data (e.g. 10m, 30s).
CACHE_TTL=10m
