# Tessera contracts env — copy to .env. Never commit real values.

# Deployer wallet (BSC testnet needs tBNB for gas).
DEPLOYER_PRIVATE_KEY=0x...

# BNB Chain RPC endpoints (public defaults; override with your own provider)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Etherscan V2 unified API key — verifies BscScan (97/56) with one key.
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
